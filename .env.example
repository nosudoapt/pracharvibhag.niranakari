# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# ---------------------------------------------------------------------------
# Auth (required)
# ---------------------------------------------------------------------------
# HMAC secret for signing admin session cookies.
# REQUIRED in production — the app refuses to start signing sessions without it.
# Generate one with:  openssl rand -hex 32
AUTH_SECRET=change-me-to-a-random-string

# Break-glass password login (always available even if Google sign-in is down)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional: the owner's email + display name. If set, ADMIN_EMAIL becomes the
# identity for the password login and is seeded as an active super_admin, so you
# can also sign in with that same email via Google.
ADMIN_EMAIL=owner@example.com
ADMIN_NAME=Site Owner

# ---------------------------------------------------------------------------
# GP attendance field team (Gyan Prachark attendance)
# ---------------------------------------------------------------------------
# Accounts for the 5-10 field people. Seeded on first boot.
# Format: username:pin:role (comma separated). Roles: viewer | editor | super_admin
# viewer      = can see the log + export attendance
# editor      = "Recorder" — can mark attendance (live & merge payloads)
# super_admin = "Admin" — everything + paste/merge payloads + manage these users
GP_ATTENDANCE_USERS=recorder1:recorder123:editor,viewer1:viewer123:viewer

# Optional break-glass admin if GP_ATTENDANCE_USERS is unset:
# GP_ADMIN_PIN=gp-admin-1234

# ---------------------------------------------------------------------------
# Bal-Mahila-EMS live attendance field team
# ---------------------------------------------------------------------------
# Accounts for the recorders marking attendance from their phones.
# Format: username:password:role (comma separated). Roles: viewer | editor | super_admin
# viewer      = read-only log
# editor      = "Recorder" — can mark present. Can NEVER undo.
# super_admin = "Admin" — everything a recorder can do + UNDO + manage users
BAL_ATTENDANCE_USERS=rec1:rec1234:editor,admin:admin1234:super_admin

# Optional break-glass admin if BAL_ATTENDANCE_USERS has no super_admin:
# BAL_ADMIN_PIN=bal-admin-1234

# ---------------------------------------------------------------------------
# Google sign-in (optional — leave blank to keep it disabled)
# ---------------------------------------------------------------------------
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console,
# then paste the values here. Setup steps are in docs/auth-cms-setup.md.
# The redirect URI you register in Google must EXACTLY match OAUTH_REDIRECT_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# e.g. http://localhost:3000/api/auth/google/callback  (dev)
#      https://your-domain.com/api/auth/google/callback (prod)
OAUTH_REDIRECT_URL=
